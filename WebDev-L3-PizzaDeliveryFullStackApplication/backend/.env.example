# Application
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
LOG_LEVEL=info

# Authentication
# Generate a random secret of at least 32 characters.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
AUTH_COOKIE_SAME_SITE=lax

# Transactional email via Brevo HTTP API. Set the sender email to a verified Brevo sender.
BREVO_API_KEY=
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=Pizza Delivery

# One-time admin provisioning. Only used by: npm run admin:create
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
